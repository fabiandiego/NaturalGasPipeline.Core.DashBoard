<Project>
  <!--
    Settings for the dashboard projects (src/, tests/).
    The engine under engine/ (git submodule) keeps its own
    Directory.Build.props and Directory.Packages.props: MSBuild stops at the
    first file it finds walking up, so nothing here leaks into the engine.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
