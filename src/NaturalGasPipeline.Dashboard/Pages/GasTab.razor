@inject AppState S
@implements IDisposable

<div class="page-head">
    <h1>Q1 · Gas properties</h1>
    <p>Composition in mole %. Everything below is computed by the engine's Thermodynamics module at the state (P, T); the same gas is used by the other tabs.</p>
</div>

<div class="grid cols-2">
    <div class="stack">
        <Card Title="Composition">
            <Aside>Σ = <span class="num @(Math.Abs(S.Gas.Total - 100) > 1e-4 ? "bad" : "")">@Fmt.N(S.Gas.Total, 4)</span> %</Aside>
            <ChildContent>
                <div class="actions" style="margin-bottom:10px">
                    <div class="field" style="flex:1">
                        <label>Preset</label>
                        <select @onchange="LoadPreset">
                            <option value="">— choose —</option>
                            @foreach (var g in Presets.Gases())
                            {
                                <option value="@g.Id">@g.Title</option>
                            }
                        </select>
                    </div>
                    <button class="btn ghost sm" style="align-self:end" @onclick="Normalize">Normalise to 100 %</button>
                </div>
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th>Component</th><th class="num">mol %</th></tr></thead>
                        <tbody>
                            @foreach (var c in S.Gas.Components)
                            {
                                <tr>
                                    <td>@EngineCatalog.Humanize(c.Name)</td>
                                    <td class="num"><input value="@c.Percent.ToString("0.#####", CultureInfo.InvariantCulture)" @onchange="e => SetPercent(c, e)" inputmode="decimal" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </Card>
        <Card Title="State">
            <div class="form">
                <NumField Label="Pressure" Unit="MPa(a)" @bind-Value="S.GasPressureMPa" @bind-Value:after="Recalc" />
                <NumField Label="Temperature" Unit="°C" @bind-Value="S.GasTemperatureC" @bind-Value:after="Recalc" />
                <EnumField TEnum="CompressibilityModelType" Class="full" Label="Z model for density / viscosity" Values="EngineCatalog.CompressibilityModels" @bind-Value="S.GasModel" @bind-Value:after="Recalc" />
                <div class="section-label">Standard (base) conditions</div>
                <NumField Label="T std" Unit="°C" @bind-Value="S.Standard.TemperatureC" @bind-Value:after="Recalc" />
                <NumField Label="P std" Unit="kPa" @bind-Value="S.Standard.PressureKPa" @bind-Value:after="Recalc" />
            </div>
        </Card>
    </div>

    <div class="stack">
        @if (_error is not null)
        {
            <div class="error-box">@_error</div>
        }
        @if (_a is not null)
        {
            var a = _a;
            <section class="card">
                <div class="kpis">
                    <div class="kpi hl"><div class="k">Z (@a.SelectedModel)</div><div class="v">@Fmt.N(a.Z, 5)</div></div>
                    <div class="kpi"><div class="k">Density ρ</div><div class="v">@Fmt.N(a.DensityKgM3, 2)<small>kg/m³</small></div></div>
                    <div class="kpi"><div class="k">Viscosity μ (LGE)</div><div class="v">@Fmt.N(a.ViscosityMicroPaS, 2)<small>µPa·s</small></div></div>
                    <div class="kpi"><div class="k">Molar mass M</div><div class="v">@Fmt.N(a.MolarMassGPerMol, 3)<small>g/mol</small></div></div>
                    <div class="kpi"><div class="k">Specific gravity γ</div><div class="v">@Fmt.N(a.SpecificGravity, 4)</div></div>
                    <div class="kpi"><div class="k">ρ at standard conditions</div><div class="v">@Fmt.N(a.StandardDensityKgM3, 4)<small>kg/m³</small></div></div>
                </div>
            </section>

            <Card Title="Calculation flow" Flush="true">
                <Aside>engine: GasMixture → PseudoCriticalProperties → ICompressibilityModel → GasState</Aside>
                <ChildContent>
                    <FlowChain Nodes="@GasFlow(a)" />
                </ChildContent>
            </Card>

            <Card Title="Compressibility factor Z at the state" Flush="true">
                <Aside>@Fmt.N(S.GasPressureMPa, 2) MPa(a), @Fmt.N(S.GasTemperatureC, 1) °C · deviation vs AGA8-DC92</Aside>
                <ChildContent>
                    <div class="table-wrap">
                        <table class="data">
                            <thead><tr><th>Model</th><th>Basis</th><th class="num">Z</th><th class="num">Δ vs AGA8</th><th>Validated range</th></tr></thead>
                            <tbody>
                                @foreach (var r in a.ZTable)
                                {
                                    <tr class="@(r.Model == a.SelectedModel ? "sel" : "")">
                                        <td>@r.Model</td>
                                        <td class="muted">@r.Basis</td>
                                        <td class="num">@(r.Z is double z ? Fmt.N(z, 5) : "—")</td>
                                        <td class="num">@(r.DeviationFromAga8Percent is double d ? (d >= 0 ? "+" : "") + Fmt.N(d, 2) + " %" : "")</td>
                                        <td>
                                            @if (r.Error is not null) { <span class="tag bad" title="@r.Error">error</span> }
                                            else if (r.WithinValidatedRange == true) { <span class="tag ok">inside</span> }
                                            else if (r.WithinValidatedRange == false) { <span class="tag warn">outside</span> }
                                            else { <span class="tag">n/a</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ChildContent>
            </Card>

            <div class="grid cols-even">
                <Card Title="Z(P) isotherm, every model" Flush="true">
                    <Sheet Code="G-01" Title="Z vs pressure">
                        <Chart Series="@ZSeries(a.ZCurves)" XLabel="Pressure P [MPa(a)]" YLabel="Z [–]" XMin="0" H="340"
                               Points="@(new[] { new ChartPoint(S.GasPressureMPa, a.Z, "state", Palette.Navy) })" />
                    </Sheet>
                </Card>
                <Card Title="Deviation from AGA8-DC92" Flush="true">
                    <Sheet Code="G-02" Title="(Z − Z_AGA8) / Z_AGA8">
                        <Chart Series="@ZSeries(a.DeviationCurves, 1)" XLabel="Pressure P [MPa(a)]" YLabel="Deviation [%]" XMin="0" H="340"
                               HLines="@(new[] { new ChartHLine(5, "+5 % (Papay acceptance vs DAK)", Palette.Red), new ChartHLine(-5, "−5 %", Palette.Red) })" />
                    </Sheet>
                </Card>
            </div>

            <Card Title="Pseudo-critical properties" Flush="true">
                <table class="data">
                    <thead><tr><th>Method</th><th class="num">Tpc [K]</th><th class="num">Ppc [MPa]</th><th class="num">Tpr</th><th class="num">Ppr</th><th>Note</th></tr></thead>
                    <tbody>
                        <tr><td>Kay (molar average)</td><td class="num">@Fmt.N(a.KayTpcK, 2)</td><td class="num">@Fmt.N(a.KayPpcMPa, 4)</td><td class="num">@Fmt.N(a.ReducedTemperature, 4)</td><td class="num">@Fmt.N(a.ReducedPressure, 4)</td><td class="muted">used by DAK, Hall-Yarborough, Papay</td></tr>
                        <tr><td>Sutton (1985), from γ</td><td class="num">@Fmt.N(a.SuttonTpcK, 2)</td><td class="num">@Fmt.N(a.SuttonPpcMPa, 4)</td><td class="num">@(a.SuttonTpcK is double st ? Fmt.N((S.GasTemperatureC + 273.15) / st, 4) : "—")</td><td class="num">@(a.SuttonPpcMPa is double sp ? Fmt.N(S.GasPressureMPa / sp, 4) : "—")</td><td>@if (a.SuttonInRange) { <span class="tag ok">γ in range</span> } else { <span class="tag warn">γ outside range</span> }</td></tr>
                        @if (a.WichertAzizTpcK is double wt)
                        {
                            <tr><td>Kay + Wichert-Aziz (CO₂, H₂S)</td><td class="num">@Fmt.N(wt, 2)</td><td class="num">@Fmt.N(a.WichertAzizPpcMPa, 4)</td><td class="num">@Fmt.N((S.GasTemperatureC + 273.15) / wt, 4)</td><td class="num">@(a.WichertAzizPpcMPa is double wp ? Fmt.N(S.GasPressureMPa / wp, 4) : "—")</td><td class="muted">sour / acid gas correction</td></tr>
                        }
                    </tbody>
                </table>
                <p class="small muted" style="margin:8px 14px 12px">γ uses @a.AirBasis. Z at standard conditions (@a.SelectedModel): @Fmt.N(a.ZStandard, 6).</p>
            </Card>

            <Card Title="Warnings" Flush="true">
                <Notes Items="a.Warnings" Empty="No warnings from the engine." />
            </Card>
        }
    </div>
</div>

@code {
    private GasAnalysis? _a;
    private string? _error;

    protected override void OnInitialized()
    {
        S.GasChanged += OnGasChanged;
        Recalc();
    }

    public void Dispose() => S.GasChanged -= OnGasChanged;

    private void OnGasChanged() { Recalc(); StateHasChanged(); }

    private void Recalc()
    {
        try
        {
            _a = GasService.Analyze(S.Gas, S.GasPressureMPa, S.GasTemperatureC, S.GasModel, S.Standard);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void SetPercent(ComponentEntry c, ChangeEventArgs e)
    {
        string s = (e.Value?.ToString() ?? "").Replace(',', '.').Trim();
        if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out double v) && v >= 0)
        {
            c.Percent = v;
            S.NotifyGasChanged();
        }
    }

    private void Normalize()
    {
        S.Gas.Normalize();
        S.NotifyGasChanged();
    }

    private void LoadPreset(ChangeEventArgs e)
    {
        var g = Presets.Gases().FirstOrDefault(x => x.Id == e.Value?.ToString());
        if (g.Composition is null) return;
        S.Gas.Set(g.Composition);
        S.NotifyGasChanged();
    }

    private static IReadOnlyList<ChartSeries> ZSeries(IReadOnlyList<Series> curves, int paletteOffset = 0) =>
        curves.Select((c, i) => new ChartSeries(
            c.Name,
            c.Points,
            Palette.At(i + paletteOffset),
            Dashed: i >= 9,
            Width: c.Name.StartsWith("AGA8") ? 3 : 1.6)).ToList();

    private IReadOnlyList<FlowChain.Node> GasFlow(GasAnalysis a) => new FlowChain.Node[]
    {
        new("Composition", "xᵢ, Σxᵢ = 1", $"{S.Gas.Components.Count(c => c.Percent > 0)} components"),
        new("Molar mass", "M = Σ xᵢ·Mᵢ", $"{Fmt.N(a.MolarMassGPerMol, 3)} g/mol"),
        new("Gravity", "γ = M / M_air", Fmt.N(a.SpecificGravity, 4)),
        new("Pseudo-critical (Kay)", "Tpc = Σ xᵢ·Tcᵢ, Ppc = Σ xᵢ·Pcᵢ", $"{Fmt.N(a.KayTpcK, 1)} K · {Fmt.N(a.KayPpcMPa, 3)} MPa"),
        new("Reduced state", "Tpr = T/Tpc, Ppr = P/Ppc", $"{Fmt.N(a.ReducedTemperature, 3)} · {Fmt.N(a.ReducedPressure, 3)}"),
        new("Compressibility", a.SelectedModel, $"Z = {Fmt.N(a.Z, 5)}"),
        new("Density", "ρ = P·M / (Z·R·T)", $"{Fmt.N(a.DensityKgM3, 2)} kg/m³"),
        new("Viscosity", "Lee-Gonzalez-Eakin μ(T, ρ, M)", $"{Fmt.N(a.ViscosityMicroPaS, 2)} µPa·s", true)
    };
}
