@inject AppState S

<div class="page-head">
    <h1>Q4 · Compressor station</h1>
    <p>N stages with equal pressure ratios and optional intercooling (engine: <code>CompressorStation</code> / <code>CompressorStage</code>). Head with mean Z: H = Z_avg·(R/M)·T1·(r<sup>x</sup> − 1)/x. Fuel and driver consumption await the engine's machinery library.</p>
</div>

<div class="grid cols-2">
    <Card Title="Inputs">
        <div class="form">
            <NumField Label="Standard flow Q" Unit="MMm³/d" @bind-Value="I.FlowMMm3PerDay" @bind-Value:after="Recalc" />
            <NumField Label="Heat-capacity ratio k" @bind-Value="I.HeatCapacityRatio" @bind-Value:after="Recalc" />
            <NumField Label="Suction pressure" Unit="MPa(a)" @bind-Value="I.SuctionPressureMPa" @bind-Value:after="Recalc" />
            <NumField Label="Suction temperature" Unit="°C" @bind-Value="I.SuctionTemperatureC" @bind-Value:after="Recalc" />
            <NumField Label="Discharge pressure" Unit="MPa(a)" @bind-Value="I.DischargePressureMPa" @bind-Value:after="Recalc" />
            <IntField Label="Stages" Min="1" Max="8" @bind-Value="I.Stages" @bind-Value:after="Recalc" />
            <EnumField TEnum="CompressionEfficiencyBasis" Label="Efficiency basis" Values="EngineCatalog.EfficiencyBases" @bind-Value="I.Basis" @bind-Value:after="Recalc" />
            <NumField Label="@(I.Basis == CompressionEfficiencyBasis.Polytropic ? "Polytropic η_p" : "Isentropic η_s")" @bind-Value="I.Efficiency" @bind-Value:after="Recalc" />
            <NumField Label="Mechanical η_m" @bind-Value="I.MechanicalEfficiency" @bind-Value:after="Recalc" />
            <OptField Label="Intercooler outlet" Unit="°C" Placeholder="no intercooling" @bind-Value="I.IntercoolerOutletC" @bind-Value:after="Recalc" />
            <EnumField TEnum="CompressibilityModelType" Class="full" Label="Z model" Values="EngineCatalog.CompressibilityModels" @bind-Value="I.ZModel" @bind-Value:after="Recalc" />
            @if (S.LastPlan is { Stations.Count: > 0 } plan)
            {
                <div class="full actions">
                    <button class="btn ghost sm" @onclick="() => FromPlan(plan.Stations[0])">Use @plan.Stations[0].Name from the station plan</button>
                </div>
            }
        </div>
    </Card>

    <div class="stack">
        @if (_error is not null)
        {
            <div class="error-box">@_error</div>
        }
        @if (_a is not null)
        {
            var a = _a;
            <section class="card">
                <div class="kpis">
                    <div class="kpi hl"><div class="k">Shaft power</div><div class="v">@Fmt.N(a.ShaftPowerMW, 2)<small>MW</small></div></div>
                    <div class="kpi"><div class="k">Gas power</div><div class="v">@Fmt.N(a.GasPowerMW, 2)<small>MW</small></div></div>
                    <div class="kpi"><div class="k">Overall ratio</div><div class="v">@Fmt.N(a.OverallRatio, 3)</div></div>
                    <div class="kpi"><div class="k">Stage ratio</div><div class="v">@Fmt.N(a.Stages[0].Ratio, 3)</div></div>
                    <div class="kpi"><div class="k">Discharge temperature</div><div class="v">@Fmt.N(a.DischargeC, 1)<small>°C</small></div></div>
                    <div class="kpi"><div class="k">Mass flow</div><div class="v">@Fmt.N(a.MassFlowKgS, 1)<small>kg/s</small></div></div>
                </div>
            </section>

            <Card Title="Compression train" Flush="true">
                <Aside>@a.ZModel</Aside>
                <ChildContent>
                    <Sheet Code="C-01" Title="Process flow, @a.Stages.Count stage(s)">
                        <svg viewBox="0 0 900 200" role="img" aria-label="Compression train">
                            @{
                                int n = a.Stages.Count;
                                bool cool = a.IntercoolerC is not null;
                                double unit = 760.0 / (n + (cool ? n - 1 : 0) + 1);
                                double x = 70;
                            }
                            <line x1="30" y1="100" x2="870" y2="100" stroke="#063a6e" stroke-width="4" />
                            <g>
                                <text x="30" y="80" font-size="12" font-weight="700" fill="#063a6e">suction</text>
                                <text x="30" y="135" font-size="11" font-family="PT Mono, monospace" fill="#3d4a5a">@Fmt.N(a.Stages[0].SuctionMPa, 2) MPa</text>
                                <text x="30" y="150" font-size="11" font-family="PT Mono, monospace" fill="#3d4a5a">@Fmt.N(a.Stages[0].SuctionC, 1) °C</text>
                            </g>
                            @for (int i = 0; i < n; i++)
                            {
                                var st = a.Stages[i];
                                x += unit;
                                double cx = x;
                                <g>
                                    <polygon points="@($"{Fmt.S(cx - 26)},134 {Fmt.S(cx - 26)},66 {Fmt.S(cx + 26)},82 {Fmt.S(cx + 26)},118")" fill="#0a5ba8" stroke="#063a6e" stroke-width="2" />
                                    <text x="@Fmt.S(cx)" y="104" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">@($"C{i + 1}")</text>
                                    <text x="@Fmt.S(cx)" y="56" text-anchor="middle" font-size="11" font-family="PT Mono, monospace" fill="#0a5ba8">r @Fmt.N(st.Ratio, 3)</text>
                                    <text x="@Fmt.S(cx)" y="156" text-anchor="middle" font-size="11" font-family="PT Mono, monospace" fill="#3d4a5a">@Fmt.N(st.ShaftPowerMW, 2) MW</text>
                                    <text x="@Fmt.S(cx)" y="171" text-anchor="middle" font-size="11" font-family="PT Mono, monospace" fill="#3d4a5a">@Fmt.N(st.DischargeMPa, 2) MPa · @Fmt.N(st.DischargeC, 0) °C</text>
                                </g>
                                if (cool && i < n - 1)
                                {
                                    x += unit;
                                    double hx = x;
                                    <g>
                                        <circle cx="@Fmt.S(hx)" cy="100" r="20" fill="#fff" stroke="#00908c" stroke-width="2.5" />
                                        <path d="@($"M{Fmt.S(hx - 14)} 100 l5 -9 l6 18 l6 -18 l6 18 l5 -9")" fill="none" stroke="#00908c" stroke-width="2" />
                                        <text x="@Fmt.S(hx)" y="70" text-anchor="middle" font-size="11" fill="#00908c">cooler</text>
                                        <text x="@Fmt.S(hx)" y="140" text-anchor="middle" font-size="11" font-family="PT Mono, monospace" fill="#00908c">→ @Fmt.N(a.IntercoolerC, 0) °C</text>
                                    </g>
                                }
                            }
                            <g>
                                <text x="870" y="80" text-anchor="end" font-size="12" font-weight="700" fill="#063a6e">discharge</text>
                                <text x="870" y="135" text-anchor="end" font-size="11" font-family="PT Mono, monospace" fill="#3d4a5a">@Fmt.N(a.Stages[^1].DischargeMPa, 2) MPa</text>
                                <text x="870" y="150" text-anchor="end" font-size="11" font-family="PT Mono, monospace" fill="#3d4a5a">@Fmt.N(a.DischargeC, 1) °C</text>
                            </g>
                        </svg>
                    </Sheet>
                </ChildContent>
            </Card>

            <div class="grid cols-even">
                <Card Title="Temperature through the train" Flush="true">
                    <Sheet Code="C-02" Title="T along the process">
                        <Chart Series="@(new[] { new ChartSeries("T", TemperaturePath(a), Palette.Flame, Width: 2.4, Markers: true) })"
                               XLabel="Process point (suction → discharge)" YLabel="Temperature [°C]" H="260" ShowLegend="false" />
                    </Sheet>
                </Card>
                <Card Title="Power vs stages" Flush="true">
                    <Sheet Code="C-03" Title="Shaft power, same duty">
                        <Chart Series="@StageSweep()" XLabel="Number of stages" YLabel="Shaft power [MW]" H="260" XMin="1" />
                    </Sheet>
                </Card>
            </div>

            <Card Title="Stages" Flush="true">
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th class="num">Stage</th><th class="num">Ps [MPa]</th><th class="num">Ts [°C]</th><th class="num">Pd [MPa]</th><th class="num">Td [°C]</th><th class="num">r</th><th class="num">Zs</th><th class="num">Zd</th><th class="num">Head [kJ/kg]</th><th class="num">Gas [MW]</th><th class="num">Shaft [MW]</th></tr></thead>
                        <tbody>
                            @foreach (var st in a.Stages)
                            {
                                <tr><td class="num">@st.Stage</td><td class="num">@Fmt.N(st.SuctionMPa, 3)</td><td class="num">@Fmt.N(st.SuctionC, 1)</td><td class="num">@Fmt.N(st.DischargeMPa, 3)</td><td class="num">@Fmt.N(st.DischargeC, 1)</td><td class="num">@Fmt.N(st.Ratio, 4)</td><td class="num">@Fmt.N(st.SuctionZ, 4)</td><td class="num">@Fmt.N(st.DischargeZ, 4)</td><td class="num">@Fmt.N(st.HeadKJkg, 1)</td><td class="num">@Fmt.N(st.GasPowerMW, 3)</td><td class="num">@Fmt.N(st.ShaftPowerMW, 3)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Card>
        }
    </div>
</div>

@code {
    private CompressorInput I => S.Compressor;
    private CompressorAnalysis? _a;
    private string? _error;

    protected override void OnInitialized() => Recalc();

    private void Recalc()
    {
        try
        {
            _a = CompressorService.Analyze(S.Gas, I);
            _error = null;
        }
        catch (Exception ex)
        {
            _a = null;
            _error = ex.Message;
        }
    }

    private void FromPlan(StationRow st)
    {
        I.SuctionPressureMPa = st.SuctionMPa;
        I.DischargePressureMPa = st.DischargeMPa;
        I.SuctionTemperatureC = S.Planner.FlowingTemperatureC;
        I.FlowMMm3PerDay = S.Planner.FlowMMm3PerDay;
        I.HeatCapacityRatio = S.Planner.HeatCapacityRatio;
        Recalc();
    }

    private static IReadOnlyList<(double X, double Y)> TemperaturePath(CompressorAnalysis a)
    {
        var pts = new List<(double, double)>();
        double x = 0;
        foreach (var st in a.Stages)
        {
            pts.Add((x, st.SuctionC));
            x += 1;
            pts.Add((x, st.DischargeC));
        }
        return pts;
    }

    /// <summary>The same duty with 1…6 stages, each a separate engine run.</summary>
    private IReadOnlyList<ChartSeries> StageSweep()
    {
        var withCooler = new List<(double, double)>();
        var without = new List<(double, double)>();
        for (int n = 1; n <= 6; n++)
        {
            var copy = Copy(I, n, I.IntercoolerOutletC ?? I.SuctionTemperatureC);
            var copyNo = Copy(I, n, null);
            try { withCooler.Add((n, CompressorService.Analyze(S.Gas, copy).ShaftPowerMW)); } catch { }
            try { without.Add((n, CompressorService.Analyze(S.Gas, copyNo).ShaftPowerMW)); } catch { }
        }
        return new[]
        {
            new ChartSeries("with intercooling", withCooler, Palette.Teal, Width: 2.2, Markers: true),
            new ChartSeries("no intercooling", without, Palette.Steel, Dashed: true, Width: 2, Markers: true)
        };
    }

    private static CompressorInput Copy(CompressorInput i, int stages, double? cooler) => new()
    {
        ZModel = i.ZModel, Standard = i.Standard, FlowMMm3PerDay = i.FlowMMm3PerDay,
        SuctionPressureMPa = i.SuctionPressureMPa, SuctionTemperatureC = i.SuctionTemperatureC,
        DischargePressureMPa = i.DischargePressureMPa, HeatCapacityRatio = i.HeatCapacityRatio,
        Basis = i.Basis, Efficiency = i.Efficiency, MechanicalEfficiency = i.MechanicalEfficiency,
        Stages = stages, IntercoolerOutletC = cooler
    };
}
